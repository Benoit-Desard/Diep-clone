{
    "name": "lan/diep-clone",
    "description": "Clone de diep.io pour LAN - serveur PHP Ratchet, client Canvas",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "cboden/ratchet": "^0.4.4",
        "react/event-loop": "^1.3",
        "react/socket": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Diep\\": "src/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php server.php"
        ],
        "web": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 0.0.0.0:8000 -t public"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
